{
  //sets the trackers layout
  //more info: https://github.com/black-sliver/PopTracker/blob/master/doc/PACKS.md#layouts
  "tracker_default": {
    "type": "container",
    "background": "#000000",
    "content": {
      "type": "dock",
      "dropshadow": true,
      "content": [
        {
          "type": "dock",
          "dock": "left",
          "v_alignment": "stretch",
          "content": [
            {
              "type": "group",
              "header": "Progressif",
              "dock": "top",
              "content": {
                "type": "layout",
                "key": "Progressif"
              }
            },
            {
              "type": "layout",
              "key": "pikmin_group",
              "dock": "top"
            },
            {
              "type": "group",
              "header": "Ship Part",
              "dock": "top",
              "content": {
                "type": "layout",
                "key": "ship_part"
              }
            },
            {
              "type": "layout",
              "key": "areas_accessible_group",
              "dock": "top"
            }
          ]
        },
        //Tab
        {
              "type": "layout",
              "key": "pikmin_location_group",
              "dock": "fill"
            }
      ]
    }
  }
}