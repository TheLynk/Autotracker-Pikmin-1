{
  //sets the trackers layout
  //more info: https://github.com/black-sliver/PopTracker/blob/master/doc/PACKS.md#layouts
  "tracker_default": {
    "type": "container",
    "background": "#000000",
    "content": {
      "type": "dock",
      "dropshadow": true,
      "content": [
        {
          "type": "dock",
          "dock": "left",
          "v_alignment": "stretch",
          "content": [
            {
              "type": "group",
              "header": "Progressif",
              "dock": "top",
              "content": {
                "type": "layout",
                "key": "Progressif"
              }
            },
            {
              "type": "layout",
              "key": "pikmin_group",
              "dock": "top"
            },
            {
              "type": "group",
              "header": "Ship Part",
              "dock": "top",
              "content": {
                "type": "layout",
                "key": "ship_part"
              }
            },
            {
              "type": "layout",
              "key": "areas_accessible_group",
              "dock": "top"
            }
          ]
        },
        //Tab
        {
          "type": "tabbed",
          "tabs": [
            {
              "title": "World Map",
              "v_alignment": "stretch",
              "h_alignment": "stretch",
              "content": {
                "type": "map",
                "maps": [
                  "world_map"
                ]
              }
            },
            {
              "title": "The Impact Site [TIS]",
              "v_alignment": "stretch",
              "h_alignment": "stretch",
              "content": {
                "type": "map",
                "maps": [
                  "the_impact_site"
                ]
              }
            },
            {
              "title": "The Forest of Hope [TFoH]",
              "v_alignment": "stretch",
              "h_alignment": "stretch",
              "content": {
                "type": "map",
                "maps": [
                  "the_forest_of_hope"
                ]
              }
            },
            {
              "title": "The Forest Navel [TFN]",
              "v_alignment": "stretch",
              "h_alignment": "stretch",
              "content": {
                "type": "map",
                "maps": [
                  "the_forest_navel"
                ]
              }
            },
            {
              "title": "The Distant Spring [TDS]",
              "v_alignment": "stretch",
              "h_alignment": "stretch",
              "content": {
                "type": "map",
                "maps": [
                  "the_distant_spring"
                ]
              }
            },
            {
              "title": "The Final Trial [TFT]",
              "v_alignment": "stretch",
              "h_alignment": "stretch",
              "content": {
                "type": "map",
                "maps": [
                  "the_final_trial"
                ]
              }
            }
          ]
        }
      ]
    }
  }
}