{
  // sets layouts for shadred items grids
  // bigger example: https://github.com/Cyb3RGER/sm_ap_tracker/blob/main/layouts/items.json
  "Pikmin": {
    "type": "itemgrid",
    "h_alignment": "left",
    "margin": "0,0,0,0",
    "item_margin": "10,0",
    "item_size": 50,
    "rows": [
      [
        "red_pikmin",
        "yellow_pikmin",
        "blue_pikmin"
      ]
    ]
  },
  "ship_part": {
    "type": "itemgrid",
